option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: mysite.wsgi:application
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: mysite.production_settings
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles
commands:
  01_prepare_database_directory:
    command: "mkdir -p /var/app/data && chown webapp:webapp /var/app/data"
container_commands:
  00_validate:
    command: "source /var/app/venv/*/bin/activate && python manage.py check && python manage.py test --noinput && black --check . && flake8 ."
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"
  03_database_permissions:
    command: "chown webapp:webapp /var/app/data/db.sqlite3 && chmod 664 /var/app/data/db.sqlite3"
  04_bootstrap_assignment:
    command: "source /var/app/venv/*/bin/activate && python manage.py bootstrap_assignment"
    leader_only: true
